# Format with the pinned Mintlify CLI, then re-stage only the .mdx files that were already staged.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.mdx')
pnpm exec mint format
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | while IFS= read -r file; do
    git add -- "$file"
  done
fi
