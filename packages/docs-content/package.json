{
  "name": "@powersync/docs-content",
  "version": "0.0.1",
  "description": "Connector snippets, agent prompts, and diagrams from the PowerSync docs.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powersync-ja/powersync-docs.git",
    "directory": "packages/docs-content"
  },
  "homepage": "https://github.com/powersync-ja/powersync-docs/tree/main/packages/docs-content#readme",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./connectors/*": {
      "types": "./dist/connectors/*.d.mts",
      "default": "./dist/connectors/*.mjs"
    },
    "./prompts/*": {
      "types": "./dist/prompts/*.d.mts",
      "default": "./dist/prompts/*.mjs"
    },
    "./images/*": "./dist/images/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
